<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OceanStock.ViewModels"
             x:Class="OceanStock.Views.UserFormView"
             x:DataType="vm:UserFormViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="40"
                    Spacing="14"
                    MaxWidth="420"
                    HorizontalAlignment="Center">

            <TextBlock Text="Formulaire utilisateur"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#023E8A"/>

            <TextBlock Text="Prénom" FontWeight="SemiBold" Foreground="#1A1A1A"/>
            <TextBox Text="{Binding FirstName}" Watermark="Prénom"/>

            <TextBlock Text="Nom" FontWeight="SemiBold" Foreground="#1A1A1A"/>
            <TextBox Text="{Binding LastName}" Watermark="Nom"/>

            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#1A1A1A"/>
            <TextBox Text="{Binding Email}" Watermark="Email"/>

            <TextBlock Text="Rôle" FontWeight="SemiBold" Foreground="#1A1A1A"/>
            <ComboBox ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="#1A1A1A"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Mot de passe" FontWeight="SemiBold" Foreground="#1A1A1A"/>
            <TextBlock Text="Laisser vide pour conserver l'actuel (modification)"
                       FontSize="11"
                       Foreground="#555"/>
            <TextBox Watermark="••••••••"
                     Text="{Binding Password}"
                     PasswordChar="*"/>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">

                <Button Content="Sauvegarder"
                        Background="#0077B6"
                        Foreground="White"
                        Padding="14,10"
                        CornerRadius="10"
                        Command="{Binding SaveCommand}"/>

                <Button Content="Annuler"
                        Background="#6C757D"
                        Foreground="White"
                        Padding="14,10"
                        CornerRadius="10"
                        Command="{Binding CancelCommand}"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</UserControl>
