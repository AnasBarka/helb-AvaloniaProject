<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OceanStock.ViewModels"
             x:Class="OceanStock.Views.EditFishView"
             x:DataType="vm:EditFishViewModel">

    <Design.DataContext>
        <vm:EditFishViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20"
                    MaxWidth="550"
                    HorizontalAlignment="Center"
                    Spacing="20">

            <TextBlock Text="Modifier le Poisson"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#023E8A"
                       HorizontalAlignment="Center"/>

            <Border CornerRadius="16"
                    Background="#E3F6FF"
                    Height="180"
                    Width="180"
                    HorizontalAlignment="Center"
                    ClipToBounds="True">

                <Button Command="{Binding ChangeImageCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">

                    <Panel>
                        <Image Source="{Binding Picture}"
                               Stretch="Uniform"
                               IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="[ photo ]"
                                       FontSize="16"
                                       Foreground="#0077B6"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Choisir une image"
                                       FontSize="13"
                                       Foreground="#0077B6"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Panel>

                </Button>
            </Border>

            <TextBlock Text="Cliquez sur l'image pour la changer"
                       FontSize="12"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

            <StackPanel>
                <TextBlock Text="Nom" FontWeight="Bold"/>
                <TextBox Text="{Binding Name}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Groupe" FontWeight="Bold"/>
                <TextBox Text="{Binding Group}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Stock" FontWeight="Bold"/>
                <TextBox Text="{Binding Stock}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Prix (€)" FontWeight="Bold"/>
                <TextBox Text="{Binding Price}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Description" FontWeight="Bold"/>
                <TextBox Text="{Binding Description}"
                         AcceptsReturn="True"
                         Height="90"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="20">

                <Button Content="Annuler"
                        Background="#6C757D"
                        Foreground="White"
                        Padding="12 8"
                        CornerRadius="10"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Sauvegarder"
                        Background="#28A745"
                        Foreground="White"
                        Padding="12 8"
                        CornerRadius="10"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</UserControl>
