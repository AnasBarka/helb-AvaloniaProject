<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:OceanStock.ViewModels"
             x:Class="OceanStock.Views.ExportPreviewView"
             x:DataType="vm:ExportPreviewViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20"
                    HorizontalAlignment="Center"
                    MaxWidth="700"
                    Spacing="20">

            <TextBlock Text="Prévisualisation de l'Export CSV"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#023E8A"
                       HorizontalAlignment="Center"/>

            <ToggleButton Content="Tout sélectionner"
                          Padding="10"
                          CornerRadius="10"
                          Foreground="White"
                          IsChecked="{Binding IsAllSelected}"
                          Command="{Binding SelectAllCommand}">
                <ToggleButton.Styles>
                    <Style Selector="ToggleButton">
                        <Setter Property="Background" Value="#6C757D"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="ToggleButton:checked">
                        <Setter Property="Background" Value="#023E8A"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="ToggleButton:pointerover">
                        <Setter Property="Background" Value="#5A6268"/>
                    </Style>
                </ToggleButton.Styles>
            </ToggleButton>
            
            <TextBlock Text="Colonnes à exporter :" FontWeight="Bold" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected}"
                                  Margin="0,0,16,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,8"/>

            <Border Background="White"
                    CornerRadius="15"
                    Padding="15"
                    BoxShadow="0 4 15 #00000022">

                <ListBox ItemsSource="{Binding PreviewList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="5"
                                    Padding="10"
                                    CornerRadius="12"
                                    Background="#F0F8FF">

                                <Grid ColumnDefinitions="Auto,80,*">

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>

                                    <Image Grid.Column="1"
                                           Width="70"
                                           Height="70"
                                           Source="{Binding Fish.Picture}"
                                           Stretch="Uniform"
                                           Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="2"
                                                Spacing="5"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Fish.Name}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="#023E8A"/>

                                        <TextBlock Text="{Binding Fish.Group}"
                                                   Foreground="#555"/>

                                        <TextBlock Text="{Binding Fish.Price, StringFormat={}{0} €}"
                                                   Foreground="#0077B6"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="20">

                <TextBlock FontWeight="Bold"
                           FontSize="16"
                           Foreground="#023E8A"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedCount, StringFormat=Sélectionné ({0})}"/>

                <Button Content="Annuler"
                        Background="#6C757D"
                        Foreground="White"
                        Padding="12 8"
                        CornerRadius="10"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Exporter"
                        Background="#0077B6"
                        Foreground="White"
                        Padding="12 8"
                        CornerRadius="10"
                        IsEnabled="{Binding CanExport}"
                        Command="{Binding ConfirmExportCommand}"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>
</UserControl>
