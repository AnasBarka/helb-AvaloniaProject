<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OceanStock.ViewModels"
             x:Class="OceanStock.Views.CollectionDetailsView"
             x:DataType="vm:CollectionDetailsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20"
                    HorizontalAlignment="Center"
                    MaxWidth="550"
                    Spacing="25">

            <Border Width="260"
                    Height="260"
                    CornerRadius="25"
                    Background="#DFF3F9"
                    ClipToBounds="True"
                    HorizontalAlignment="Center"
                    BoxShadow="0 10 25 #00000033">
                <Image Source="{Binding MyFish.Picture}"
                       Stretch="Uniform"/>
            </Border>

            <StackPanel HorizontalAlignment="Center"
                        Spacing="8">

                <TextBlock Text="{Binding MyFish.Name}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#023E8A"/>

                <TextBlock Text="{Binding MyFish.Price, StringFormat={}{0} €}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0096C7"/>
            </StackPanel>

            <Border Background="White"
                    Padding="25"
                    CornerRadius="20"
                    BoxShadow="0 6 20 #00000022">

                <StackPanel Spacing="14">

                    <TextBlock Text="{Binding MyFish.Group, StringFormat=Groupe : {0}}"
                               FontSize="17"
                               Foreground="#595959"/>

                    <TextBlock Text="{Binding MyFish.Id, StringFormat=ID : {0}}"
                               FontSize="17"
                               Foreground="#595959"/>

                    <TextBlock Text="{Binding MyFish.Stock, StringFormat=Stock : {0}}"
                               FontSize="17"
                               Foreground="#595959"/>

                    <TextBlock Text="Description"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#023E8A"
                               Margin="0 10 0 0"/>

                    <Border Background="#F6FBFF"
                            CornerRadius="12"
                            Padding="12"
                            BoxShadow="0 3 10 #00000015">
                        <TextBlock Text="{Binding MyFish.Description}"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   Foreground="#333"/>
                    </Border>

                    <Button Content="Modifier"
                            Background="#0096C7"
                            Foreground="White"
                            Padding="10 8"
                            CornerRadius="10"
                            Command="{Binding EditCommand}"
                            IsVisible="{Binding CanModify}"/>

                    <Button Content="Supprimer"
                            Background="#D9534F"
                            Foreground="White"
                            Padding="10 8"
                            CornerRadius="10"
                            Command="{Binding DeleteCommand}"
                            IsVisible="{Binding CanModify}"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
