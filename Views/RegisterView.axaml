<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OceanStock.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OceanStock.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">
    
    <Design.DataContext>
        <vm:RegisterViewModel />
    </Design.DataContext>

    <Border Padding="20">
        <StackPanel Spacing="10">

            <TextBlock Text="Créer un compte"
                       FontSize="24"
                       HorizontalAlignment="Center"/>

            <TextBox Watermark="Prénom"
                     Text="{Binding FirstName}"/>

            <TextBox Watermark="Nom"
                     Text="{Binding LastName}"/>

            <TextBox Watermark="Email"
                     Text="{Binding Email}"/>

            <TextBox Watermark="Mot de passe"
                     Text="{Binding Password}"
                     PasswordChar="*"/>

            <Button Content="Créer"
                    Command="{Binding RegisterCommand}"/>

            <Button Content="Retour"
                    Command="{Binding BackCommand}"/>

        </StackPanel>
    </Border>

</UserControl>