<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OceanStock.ViewModels"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:helpers="using:OceanStock.Helpers"
             x:Class="OceanStock.Views.AdminView"
             x:DataType="vm:AdminViewModel">

    <UserControl.Resources>
        <helpers:BoolToRoleConverter x:Key="BoolToRoleConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*"
          Margin="20">

        <StackPanel Spacing="10">

            <TextBlock Text="Administration des utilisateurs"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0A2540"/>

            <TextBlock Text="{Binding FilteredUsers.Count, StringFormat='Utilisateurs : {0}'}"
                       Foreground="#333"/>

            <TextBox Watermark="Rechercher..."
                     Width="300"
                     HorizontalAlignment="Left"
                     Text="{Binding SearchText}"/>

            <StackPanel Orientation="Horizontal" Spacing="10">

                <Button Content="Ajouter"
                        Width="100"
                        Command="{Binding CreateUserCommand}"/>

                <Button Content="Modifier"
                        Width="100"
                        Command="{Binding UpdateUserCommand}"/>

                <Button Content="Supprimer"
                        Width="100"
                        Command="{Binding DeleteUserCommand}"/>

                <Button Content="Voir collection"
                        Width="150"
                        Command="{Binding ViewCollectionCommand}"/>

            </StackPanel>

        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,15,0,0"
                CornerRadius="10"
                Background="White"
                Padding="5">

            <dg:DataGrid ItemsSource="{Binding FilteredUsers}"
                         SelectedItem="{Binding SelectedUser}"
                         SelectionMode="Single"
                         AutoGenerateColumns="False"
                         GridLinesVisibility="All"
                         HeadersVisibility="Column"
                         IsReadOnly="True"
                         RowHeight="45"
                         Background="White">

                <dg:DataGrid.Styles>
                    <Style Selector="dg|DataGridCell">
                        <Setter Property="Foreground" Value="#1A1A1A"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                    <Style Selector="dg|DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#0A2540"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="#E6F4F9"/>
                    </Style>
                </dg:DataGrid.Styles>

                <dg:DataGrid.Columns>

                    <dg:DataGridTextColumn Header="Prénom"
                                           Binding="{Binding FirstName}"
                                           Width="*"/>

                    <dg:DataGridTextColumn Header="Nom"
                                           Binding="{Binding LastName}"
                                           Width="*"/>

                    <dg:DataGridTextColumn Header="E-mail"
                                           Binding="{Binding Email}"
                                           Width="2*"/>

                    <dg:DataGridTemplateColumn Header="Rôle" Width="*">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsAdmin, Converter={StaticResource BoolToRoleConverter}}"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                </dg:DataGrid.Columns>

            </dg:DataGrid>

        </Border>

    </Grid>

</UserControl>
