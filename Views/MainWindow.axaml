<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OceanStock.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="500"
        x:Class="OceanStock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/Fishico.ico"
        Title="OceanStock">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#00B4D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#0096C7"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="70,*">

        <Border Grid.Row="0" Background="#0A2540" Padding="15">
            <StackPanel>
                <TextBlock Text="OceanStock"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Version 1.1"
                           Foreground="#B0C4DE"
                           FontSize="14"
                           Margin="2,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <Border Background="#123A5A" Padding="15">

                <StackPanel Spacing="8" IsVisible="{Binding IsLoggedIn}">

                    <Button Content="Accueil"
                            Height="40"
                            Command="{Binding ShowMyCollectionCommand}"/>
                    <Button Content="Ajouter un article"
                            Height="40"
                            Command="{Binding GoToAddFishCommand}"/>
                    <Button Content="Import CSV"
                            Height="40"
                            Command="{Binding ImportCsvCommand}"/>
                    <Button Content="Export CSV"
                            Height="40"
                            Command="{Binding ExportCsvCommand}"/>
                    <Button Content="Statistiques"
                            Height="40"
                            Command="{Binding GoToStatsCommand}"/>
                    <Button Content="Administration"
                            Height="40"
                            Command="{Binding GoToAdminCommand}"
                            IsVisible="{Binding IsAdmin}"/>

                    <Border Height="1" Background="#2A5A7A" Margin="0,8"/>

                    <Button Content="Mon profil"
                            Height="40"
                            Background="#1E5C8A"
                            Command="{Binding GoToProfileCommand}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#174D77"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <Button Content="Déconnexion"
                            Height="40"
                            Background="#8B2020"
                            Command="{Binding LogoutCommand}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#6E1A1A"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Background="#E6F4F9"
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>

        </Grid>
    </Grid>
</Window>
