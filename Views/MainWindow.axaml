<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyProjectBase.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="500"
        x:Class="MyProjectBase.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="🐟 Fish Manager">
    
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#00B4D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#0096C7"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="70,*">

        <!-- ✅ HEADER -->
        
        <Border Grid.Row="0"
                Background="#0A2540"
                Padding="15">

            <StackPanel>

                <!-- ✅ Titre principal -->
                <TextBlock Text="🐟 Fish Manager"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- ✅ Version -->
                <TextBlock Text="Version 1.0"
                           Foreground="#B0C4DE"
                           FontSize="14"
                           Margin="2,2,0,0"/>

            </StackPanel>

        </Border>


        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- ✅ MENU -->
            <Border Background="#123A5A" Padding="15">

                <StackPanel Spacing="12">

                    <Button Content="🏠 Accueil"
                            Height="40"
                            Command="{Binding BackToMainCommand}"/>

                    <Button Content="📥 Import CSV"
                            Height="40"
                            Command="{Binding ImportCsvCommand}"/>

                    <Button Content="📤 Export CSV"
                            Height="40"
                            Command="{Binding ExportCsvCommand}"/>
                    
                </StackPanel>

            </Border>

            <!-- ✅ CONTENU -->
            <Border Grid.Column="1"
                    Background="#E6F4F9"
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>

        </Grid>
    </Grid>
</Window>