<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyProjectBase.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MyProjectBase.Views.CollectionView"
        x:DataType="vm:CollectionViewModel"
        x:Name="Collection">
    
    <!-- Design uniquement -->
    <Design.DataContext>
        <vm:CollectionViewModel/>
    </Design.DataContext>
    
    <DockPanel Margin="20">
        <Border Background="AliceBlue">
            <ScrollViewer>
                
                <ListBox x:Name="ProductsList"
                         ItemsSource="{Binding ProductsFish}"
                         SelectedItem="{Binding SelectedProduct}"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            
                            <Border Background="Gainsboro"
                                    BorderBrush="Black"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Padding="10"
                                    Margin="10">
                                
                                <Grid ColumnDefinitions="*,*,*">
                                    
                                    <!-- IMAGE (optionnel pour Product) -->
                                    <Panel>
                                        <Rectangle Height="100" Width="100" Fill="LightGray"/>
                                    </Panel>

                                    <!-- INFOS PRODUIT -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        
                                        <TextBlock Text="{Binding ID, StringFormat=ID : {0}}"/>
                                        <TextBlock Text="{Binding Name, StringFormat=Nom : {0}}"/>
                                        <TextBlock Text="{Binding Group, StringFormat=Groupe : {0}}"/>
                                        <TextBlock Text="{Binding Stock, StringFormat=Stock : {0}}"/>
                                        <TextBlock Text="{Binding Price, StringFormat=Prix : {0} €}"/>
                                        
                                    </StackPanel>

                                    <!-- BOUTON ACTION -->
                                    <Button Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="Détails"
                                            Command="{Binding DataContext.FromParentCommand, ElementName=Collection}"
                                            CommandParameter="{Binding ID}" />
                                </Grid>
                                
                            </Border>
                            
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    
                </ListBox>
                
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>